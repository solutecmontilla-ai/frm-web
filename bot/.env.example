# Token del bot (obtenido de @BotFather en Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmnoPQRstUVwxyz

# IDs de Telegram de los admins (separados por comas)
# Para obtener tu ID, escribe /start al bot @userinfobot
ADMIN_IDS=123456789,987654321

# Ruta absoluta al directorio public/data en el servidor
# Ejemplo en VPS: /home/frmweb/public_html/data
DATA_PATH=/home/frmweb/public_html/data
